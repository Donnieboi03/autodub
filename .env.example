# Copy to .env and fill in. Never commit .env.

ELEVENLABS_API_KEY=
# Optional: default model for caption TTS (Flash is cheapest/fastest).
# AUTODUB_TTS_MODEL overrides ELEVENLABS_TTS_MODEL when set (e.g. eleven_multilingual_v2 for expressive listen).
# CLI: autodub run --model eleven_multilingual_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# AUTODUB_TTS_MODEL=

# Optional local TTS later
# COSYVOICE_DEVICE=cuda

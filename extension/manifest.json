{
  "manifest_version": 3,
  "name": "AutoDub Overlay",
  "version": "0.1.0",
  "description": "Prefetch caption-faithful EN dialogue and play on-point over HTML5 video.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["file:///*", "http://127.0.0.1/*", "http://localhost/*"],

  "action": {
    "default_title": "AutoDub Overlay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["file:///*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fixture.html", "chunks/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
